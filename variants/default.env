# Default variant: Qwen3.8-27B NVFP4 (Neroued artifact) on upstream NInfer.
#
# The served artifact is the v3 upgrade of the downloaded v2 file (the engine
# requires v3: tools/upgrade_ninfer_v2_to_v3.py). The v2 original is kept next
# to it in the models dir for reference.
NINFER_SRC=../ninfer
SRC_DIR=ninfer-src
CMAKE_EXTRA_ARGS=

IMAGE_TAG=ninfer-qwen38-27b-nvfp4:latest
CONTAINER_NAME=ninfer
COMPOSE_PROJECT=qwen38-27b-nvfp4-ninfer
HOST_PORT=8080

MODEL_FILE=/models/qwen3_8_27b_nvfp4.v3.ninfer
MODEL_ID=qwen3.8-27b

MAX_CONTEXT=262144
KV_CAPACITY=auto
MAX_CONCURRENCY=4
KV_DTYPE=fp8
EXTRA_ARGS="--device-state-slots 2 --host-state-slots 8 --host-kv-mib 8192 --spec mtp --draft-tokens 3 --lm-head-draft --preserve-thinking"
