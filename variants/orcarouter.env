# OrcaRouter variant: Qwen3.8-27B Uncensored NVFP4 (abliterated) — the artifact
# is published by igorls and requires the NInfer fork, see MODEL_NOTES.md.
#
# Engine: igorls/ninfer @ 91ce2f2c (the artifact manifest's minimum_revision).
# That revision is MSVC-only in part, so run.sh applies the patch in
# patches/orcarouter/ and CMAKE_EXTRA_ARGS drops the unused Flash-Next target.
NINFER_SRC=../ninfer-orcarouter
SRC_DIR=ninfer-src-orcarouter
CMAKE_EXTRA_ARGS=-DNINFER_WITH_FLASH_NEXT=OFF

IMAGE_TAG=ninfer-qwen38-27b-orcarouter-nvfp4:latest
CONTAINER_NAME=ninfer-orcarouter
COMPOSE_PROJECT=qwen38-27b-orcarouter-nvfp4-ninfer
HOST_PORT=8081

MODEL_FILE=/models/orcarouter/qwen3_8_27b_orcarouter_nvfp4.ninfer
MODEL_ID=qwen3.8-27b-orcarouter

MAX_CONTEXT=32768
KV_CAPACITY=65536
MAX_CONCURRENCY=2
KV_DTYPE=fp8
EXTRA_ARGS="--desktop-reserve-gib 0 --prefill-chunk 2048 --spec mtp --draft-tokens 5 --lm-head-draft --preserve-thinking"
